# ── LOCAL (Windows + PM2) ────────────────────────────────────────────────────

# From @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID — get it from @userinfobot
# Comma-separated for multiple: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# Absolute path to your project directory (local only)
CLAUDE_PROJECT_DIR=D:ilalwebsiteilalmeccai.com


# ── CLOUD (Railway) ───────────────────────────────────────────────────────────

# Anthropic API key — required on Railway (no interactive login available)
# Get it at: https://console.anthropic.com → API Keys
# Not needed locally if you use claude auth login
ANTHROPIC_API_KEY=

# GitHub Personal Access Token — needed for git push from Railway
# Create at: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# Permissions needed: Contents (read + write)
GITHUB_TOKEN=

# GitHub repo in owner/repo format
GITHUB_REPO=bilalmeccai/bilalmeccai.com
