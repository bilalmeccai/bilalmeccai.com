# Get this from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID (get it from @userinfobot or /whoami command)
# Comma-separated for multiple users, e.g.: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# Absolute path to your project directory
CLAUDE_PROJECT_DIR=D:ilalwebsiteilalmeccai.com

# Optional — only needed if using a direct Anthropic API key instead of
# Claude Code's stored OAuth credentials (from ).
# If omitted, the bot uses your existing Claude Code session credentials.
# If your system env has a stale ANTHROPIC_API_KEY, the bot strips it automatically.
# Get a key at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
